FROM nginx:latest

# Installa iptables per le regole firewall
RUN apt-get update && \
    apt-get install -y iptables iproute2 tcpdump && \
    rm -rf /var/lib/apt/lists/*

# Copia e rendi eseguibile lo script per applicare le regole
COPY setup_defense.sh /docker-entrypoint.d/99-setup-defense.sh
RUN chmod +x /docker-entrypoint.d/99-setup-defense.sh